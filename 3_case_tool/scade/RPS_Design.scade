  -- Input validity check: VALID while the analog value lies inside [MIN, MAX].
  function FB_RANGE_CHECK
    (X : float64; MIN : float64; MAX : float64)
    returns (VALID : bool)
  let
    VALID = ((X >= MIN) and (X <= MAX));
  tel

  -- Operating-bypass permissive, rising: PERM while the input is valid and X >= LIM.
  function FB_PERMISSIVE_ABOVE
    (VALID : bool; X : float64; LIM : float64)
    returns (PERM : bool)
  let
    PERM = (VALID and (X >= LIM));
  tel

  -- Operating-bypass permissive, falling: PERM while the input is valid and X < LIM.
  function FB_PERMISSIVE_BELOW
    (VALID : bool; X : float64; LIM : float64)
    returns (PERM : bool)
  let
    PERM = (VALID and (X < LIM));
  tel

  -- Rising-edge detector: one-scan pulse per press.  PREV starts TRUE, so a pushbutton that is held or stuck at power-up is ignored until it has been seen released (an IEC 61131-3 R_TRIG whose memory starts TRUE instead of the standard FALSE).
  node FB_EDGE
    (PB : bool)
    returns (Q : bool)
  var
    PREV : bool last = true;
  let
    Q = (PB and (not last 'PREV));
    PREV = PB;
  tel

  -- Operating bypass: reset-dominant latch, set by an initiation pulse while the permissive holds and reset in the first scan without permissive.  Starts removed.
  node FB_OPERATING_BYPASS
    (PERM : bool; PULSE : bool)
    returns (Q : bool)
  var
    MEM : bool last = false;
  let
    MEM = (PERM and (last 'MEM or PULSE));
    Q = MEM;
  tel

  -- Clamp: Q = MN if IN <= MN, MX if IN >= MX, otherwise IN.
  function FB_LIMIT
    (IN : float64; MN : float64; MX : float64)
    returns (Q : float64)
  let
    Q = (if (IN <= MN) then MN else (if (IN >= MX) then MX else IN));
  tel

  -- Variable setpoint that follows a decreasing target at once and rises by at most STEP per scan.  It starts at INIT, is set to the target on the first scan with a valid input, and holds while the input is invalid.  The start value is applied on the first scan (STARTED) so that every state variable has a constant initial value.
  node FB_SP_RATE_UP
    (VALID : bool; TGT : float64; STEP : float64; INIT : float64)
    returns (Q : float64)
  var
    SP : float64 last = 0.0;
    READY : bool last = false;
    STARTED : bool last = false;
    SP0 : float64;
  let
    SP0 = (if (not last 'STARTED) then INIT else last 'SP);
    SP = (if (not VALID) then SP0 else (if (not last 'READY) then TGT else (if (TGT <= SP0) then TGT else (if ((TGT - SP0) <= STEP) then TGT else (SP0 + STEP)))));
    READY = (if VALID then true else last 'READY);
    STARTED = true;
    Q = SP;
  tel

  -- Variable setpoint that follows an increasing target at once and falls by at most STEP per scan.  It starts at INIT, is set to the target on the first scan with a valid input, and holds while the input is invalid.
  node FB_SP_RATE_DOWN
    (VALID : bool; TGT : float64; STEP : float64; INIT : float64)
    returns (Q : float64)
  var
    SP : float64 last = 0.0;
    READY : bool last = false;
    STARTED : bool last = false;
    SP0 : float64;
  let
    SP0 = (if (not last 'STARTED) then INIT else last 'SP);
    SP = (if (not VALID) then SP0 else (if (not last 'READY) then TGT else (if (TGT >= SP0) then TGT else (if ((SP0 - TGT) <= STEP) then TGT else (SP0 - STEP)))));
    READY = (if VALID then true else last 'READY);
    STARTED = true;
    Q = SP;
  tel

  -- Manually reset falling setpoint: starts at MAX, rises automatically to stay no more than BAND below X (up to MAX); each reset pulse lowers it to X - BAND (not below MIN).  Holds while the input is invalid.
  node FB_SP_MANUAL_RESET
    (VALID : bool; X : float64; PULSE : bool; BAND : float64; MIN : float64; MAX : float64)
    returns (Q : float64)
  var
    SP : float64 last = 0.0;
    STARTED : bool last = false;
    SP0 : float64;
    D : float64;
  let
    SP0 = (if (not last 'STARTED) then MAX else last 'SP);
    D = (X - BAND);
    SP = (if (not VALID) then SP0 else (if ((D > SP0) and (D <= MAX)) then D else (if ((D > MAX) and (SP0 < MAX)) then MAX else (if ((PULSE and (D < SP0)) and (D >= MIN)) then D else (if ((PULSE and (D < MIN)) and (SP0 > MIN)) then MIN else SP0)))));
    STARTED = true;
    Q = SP;
  tel

  -- Trip (or pre-trip) bistable with persistence counter, hysteresis latch and fail-safe error handling.  LATCH holds a process trip: it is kept through errors and released only by RESET or BYP in an error-free scan.  HOLD keeps the output tripped after an error or at start-up until the condition clears or has persisted for DELAY scans.  TIMING and CNT count the persistence of the arming condition in scans (CNT stays in [0, DELAY - 1]).
  node FB_TRIP_BISTABLE
    (OK : bool; BYP : bool; COND : bool; RESET : bool; DELAY : int32)
    returns (Q : bool)
  var
    LATCH : bool last = false;
    HOLD : bool last = true;
    TIMING : bool last = false;
    CNT : int32 last = 0;
    ARM : bool;
    REL : bool;
    FIRE : bool;
  let
    ARM = ((OK and (not BYP)) and COND);
    REL = (OK and (BYP or RESET));
    FIRE = ((((OK and (not last 'LATCH)) and ARM) and last 'TIMING) and ((last 'CNT + 1) >= DELAY));
    LATCH = (if (not OK) then last 'LATCH else (if (last 'LATCH and REL) then false else (if last 'LATCH then true else (if FIRE then true else false))));
    HOLD = (if ((not OK) and (not last 'LATCH)) then true else (if (not OK) then last 'HOLD else (if (last 'LATCH and REL) then false else (if last 'LATCH then last 'HOLD else (if (not ARM) then false else (if FIRE then false else last 'HOLD))))));
    TIMING = (if (not OK) then false else (if last 'LATCH then last 'TIMING else (if (not ARM) then false else (if FIRE then false else true))));
    CNT = (if (not OK) then 0 else (if last 'LATCH then last 'CNT else (if (not ARM) then 0 else (if FIRE then 0 else (if last 'TIMING then (last 'CNT + 1) else 0)))));
    Q = ((not LATCH) and (not HOLD));
  tel

  -- 2-out-of-4 coincidence with trip channel bypass (2-out-of-3 when exactly one channel requests bypass; all requests ignored when two or more do) and failed links counted as trip votes.  Pure boolean logic, no arithmetic.
  function FB_VOTE_2OO4
    (TRIP_A : bool; TRIP_B : bool; TRIP_C : bool; TRIP_D : bool; BYP_A : bool; BYP_B : bool;
      BYP_C : bool; BYP_D : bool; LINK_A : bool; LINK_B : bool; LINK_C : bool; LINK_D : bool)
    returns (COINC : bool)
  var
    ONE_BYP : bool;
    V_A : bool;
    V_B : bool;
    V_C : bool;
    V_D : bool;
  let
    ONE_BYP = ((((((BYP_A and (not BYP_B)) and (not BYP_C)) and (not BYP_D)) or ((((not BYP_A) and BYP_B) and (not BYP_C)) and (not BYP_D))) or ((((not BYP_A) and (not BYP_B)) and BYP_C) and (not BYP_D))) or ((((not BYP_A) and (not BYP_B)) and (not BYP_C)) and BYP_D));
    V_A = ((not (BYP_A and ONE_BYP)) and ((not TRIP_A) or LINK_A));
    V_B = ((not (BYP_B and ONE_BYP)) and ((not TRIP_B) or LINK_B));
    V_C = ((not (BYP_C and ONE_BYP)) and ((not TRIP_C) or LINK_C));
    V_D = ((not (BYP_D and ONE_BYP)) and ((not TRIP_D) or LINK_D));
    COINC = (not ((((((V_A and V_B) or (V_A and V_C)) or (V_A and V_D)) or (V_B and V_C)) or (V_B and V_D)) or (V_C and V_D)));
  tel

  -- Reactor trip initiation: Q is FALSE (initiate) when any coincidence trip is present.
  function FB_INITIATION
    (TRIPPED : bool)
    returns (Q : bool)
  let
    Q = (not TRIPPED);
  tel

  -- Bistable Processor: Per-channel design: input validation, shared permissive, then for each trip function the bypass, setpoint and bistable blocks.  Signals carry the names of the NuSCR variables they implement.
  node BP
    (f_NPWR_LIN : float64; f_NPWR_LOG : float64; f_PZR_P : float64; f_SG1_L : float64;
      f_SG2_L : float64; f_SG1_P : float64; f_SG2_P : float64; f_CTMT_P : float64;
      f_SG1_F : float64; f_SG2_F : float64; f_LPD_HI_Trip_In : bool; f_LPD_HI_Pretrip_In : bool;
      f_DNBR_LO_Trip_In : bool; f_DNBR_LO_Pretrip_In : bool; f_CPC_Link_Error : bool;
      f_Module_Error : bool; f_Channel_Error : bool; f_LOGP_HI_OB_Ini : bool;
      f_LPD_HI_OB_Ini : bool; f_DNBR_LO_OB_Ini : bool; f_PZR_P_LO_OB_Ini : bool;
      f_SG1_P_LO_OB_Ini : bool; f_SG2_P_LO_OB_Ini : bool; f_SG1_F_LO_OB_Ini : bool;
      f_SG2_F_LO_OB_Ini : bool; f_PZR_P_LO_SP_Reset : bool; f_SG1_P_LO_SP_Reset : bool;
      f_SG2_P_LO_SP_Reset : bool; f_VOPT_Byp_Sw : bool; f_LOGP_HI_Byp_Sw : bool;
