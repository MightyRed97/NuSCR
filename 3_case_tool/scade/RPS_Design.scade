  -- Coincidence Processor: One FB_VOTE_2OO4 per trip function and one FB_INITIATION.
  node CP
    (f_A_VOPT_Trip : bool; f_A_VOPT_Byp : bool; f_A_LOGP_HI_Trip : bool; f_A_LOGP_HI_Byp : bool;
      f_A_LPD_HI_Trip : bool; f_A_LPD_HI_Byp : bool; f_A_DNBR_LO_Trip : bool;
      f_A_DNBR_LO_Byp : bool; f_A_PZR_P_HI_Trip : bool; f_A_PZR_P_HI_Byp : bool;
      f_A_PZR_P_LO_Trip : bool; f_A_PZR_P_LO_Byp : bool; f_A_SG1_L_LO_Trip : bool;
      f_A_SG1_L_LO_Byp : bool; f_A_SG2_L_LO_Trip : bool; f_A_SG2_L_LO_Byp : bool;
      f_A_SG1_L_HI_Trip : bool; f_A_SG1_L_HI_Byp : bool; f_A_SG2_L_HI_Trip : bool;
      f_A_SG2_L_HI_Byp : bool; f_A_SG1_P_LO_Trip : bool; f_A_SG1_P_LO_Byp : bool;
      f_A_SG2_P_LO_Trip : bool; f_A_SG2_P_LO_Byp : bool; f_A_CTMT_P_HI_Trip : bool;
      f_A_CTMT_P_HI_Byp : bool; f_A_SG1_F_LO_Trip : bool; f_A_SG1_F_LO_Byp : bool;
      f_A_SG2_F_LO_Trip : bool; f_A_SG2_F_LO_Byp : bool; f_B_VOPT_Trip : bool; f_B_VOPT_Byp : bool;
      f_B_LOGP_HI_Trip : bool; f_B_LOGP_HI_Byp : bool; f_B_LPD_HI_Trip : bool;
      f_B_LPD_HI_Byp : bool; f_B_DNBR_LO_Trip : bool; f_B_DNBR_LO_Byp : bool;
      f_B_PZR_P_HI_Trip : bool; f_B_PZR_P_HI_Byp : bool; f_B_PZR_P_LO_Trip : bool;
      f_B_PZR_P_LO_Byp : bool; f_B_SG1_L_LO_Trip : bool; f_B_SG1_L_LO_Byp : bool;
      f_B_SG2_L_LO_Trip : bool; f_B_SG2_L_LO_Byp : bool; f_B_SG1_L_HI_Trip : bool;
      f_B_SG1_L_HI_Byp : bool; f_B_SG2_L_HI_Trip : bool; f_B_SG2_L_HI_Byp : bool;
      f_B_SG1_P_LO_Trip : bool; f_B_SG1_P_LO_Byp : bool; f_B_SG2_P_LO_Trip : bool;
      f_B_SG2_P_LO_Byp : bool; f_B_CTMT_P_HI_Trip : bool; f_B_CTMT_P_HI_Byp : bool;
      f_B_SG1_F_LO_Trip : bool; f_B_SG1_F_LO_Byp : bool; f_B_SG2_F_LO_Trip : bool;
      f_B_SG2_F_LO_Byp : bool; f_C_VOPT_Trip : bool; f_C_VOPT_Byp : bool; f_C_LOGP_HI_Trip : bool;
      f_C_LOGP_HI_Byp : bool; f_C_LPD_HI_Trip : bool; f_C_LPD_HI_Byp : bool;
      f_C_DNBR_LO_Trip : bool; f_C_DNBR_LO_Byp : bool; f_C_PZR_P_HI_Trip : bool;
      f_C_PZR_P_HI_Byp : bool; f_C_PZR_P_LO_Trip : bool; f_C_PZR_P_LO_Byp : bool;
      f_C_SG1_L_LO_Trip : bool; f_C_SG1_L_LO_Byp : bool; f_C_SG2_L_LO_Trip : bool;
      f_C_SG2_L_LO_Byp : bool; f_C_SG1_L_HI_Trip : bool; f_C_SG1_L_HI_Byp : bool;
      f_C_SG2_L_HI_Trip : bool; f_C_SG2_L_HI_Byp : bool; f_C_SG1_P_LO_Trip : bool;
      f_C_SG1_P_LO_Byp : bool; f_C_SG2_P_LO_Trip : bool; f_C_SG2_P_LO_Byp : bool;
      f_C_CTMT_P_HI_Trip : bool; f_C_CTMT_P_HI_Byp : bool; f_C_SG1_F_LO_Trip : bool;
      f_C_SG1_F_LO_Byp : bool; f_C_SG2_F_LO_Trip : bool; f_C_SG2_F_LO_Byp : bool;
      f_D_VOPT_Trip : bool; f_D_VOPT_Byp : bool; f_D_LOGP_HI_Trip : bool; f_D_LOGP_HI_Byp : bool;
      f_D_LPD_HI_Trip : bool; f_D_LPD_HI_Byp : bool; f_D_DNBR_LO_Trip : bool;
      f_D_DNBR_LO_Byp : bool; f_D_PZR_P_HI_Trip : bool; f_D_PZR_P_HI_Byp : bool;
      f_D_PZR_P_LO_Trip : bool; f_D_PZR_P_LO_Byp : bool; f_D_SG1_L_LO_Trip : bool;
      f_D_SG1_L_LO_Byp : bool; f_D_SG2_L_LO_Trip : bool; f_D_SG2_L_LO_Byp : bool;
      f_D_SG1_L_HI_Trip : bool; f_D_SG1_L_HI_Byp : bool; f_D_SG2_L_HI_Trip : bool;
      f_D_SG2_L_HI_Byp : bool; f_D_SG1_P_LO_Trip : bool; f_D_SG1_P_LO_Byp : bool;
      f_D_SG2_P_LO_Trip : bool; f_D_SG2_P_LO_Byp : bool; f_D_CTMT_P_HI_Trip : bool;
      f_D_CTMT_P_HI_Byp : bool; f_D_SG1_F_LO_Trip : bool; f_D_SG1_F_LO_Byp : bool;
      f_D_SG2_F_LO_Trip : bool; f_D_SG2_F_LO_Byp : bool; f_A_Link_Error : bool;
      f_B_Link_Error : bool; f_C_Link_Error : bool; f_D_Link_Error : bool)
    returns (f_VOPT_Coinc : bool; f_LOGP_HI_Coinc : bool; f_LPD_HI_Coinc : bool;
      f_DNBR_LO_Coinc : bool; f_PZR_P_HI_Coinc : bool; f_PZR_P_LO_Coinc : bool;
      f_SG1_L_LO_Coinc : bool; f_SG2_L_LO_Coinc : bool; f_SG1_L_HI_Coinc : bool;
      f_SG2_L_HI_Coinc : bool; f_SG1_P_LO_Coinc : bool; f_SG2_P_LO_Coinc : bool;
      f_CTMT_P_HI_Coinc : bool; f_SG1_F_LO_Coinc : bool; f_SG2_F_LO_Coinc : bool; f_RT_Init : bool)
  let
    f_VOPT_Coinc = FB_VOTE_2OO4(f_A_VOPT_Trip, f_B_VOPT_Trip, f_C_VOPT_Trip, f_D_VOPT_Trip, f_A_VOPT_Byp, f_B_VOPT_Byp, f_C_VOPT_Byp, f_D_VOPT_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- VOPT_VOTE
    f_LOGP_HI_Coinc = FB_VOTE_2OO4(f_A_LOGP_HI_Trip, f_B_LOGP_HI_Trip, f_C_LOGP_HI_Trip, f_D_LOGP_HI_Trip, f_A_LOGP_HI_Byp, f_B_LOGP_HI_Byp, f_C_LOGP_HI_Byp, f_D_LOGP_HI_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- LOGP_HI_VOTE
    f_LPD_HI_Coinc = FB_VOTE_2OO4(f_A_LPD_HI_Trip, f_B_LPD_HI_Trip, f_C_LPD_HI_Trip, f_D_LPD_HI_Trip, f_A_LPD_HI_Byp, f_B_LPD_HI_Byp, f_C_LPD_HI_Byp, f_D_LPD_HI_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- LPD_HI_VOTE
    f_DNBR_LO_Coinc = FB_VOTE_2OO4(f_A_DNBR_LO_Trip, f_B_DNBR_LO_Trip, f_C_DNBR_LO_Trip, f_D_DNBR_LO_Trip, f_A_DNBR_LO_Byp, f_B_DNBR_LO_Byp, f_C_DNBR_LO_Byp, f_D_DNBR_LO_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- DNBR_LO_VOTE
    f_PZR_P_HI_Coinc = FB_VOTE_2OO4(f_A_PZR_P_HI_Trip, f_B_PZR_P_HI_Trip, f_C_PZR_P_HI_Trip, f_D_PZR_P_HI_Trip, f_A_PZR_P_HI_Byp, f_B_PZR_P_HI_Byp, f_C_PZR_P_HI_Byp, f_D_PZR_P_HI_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- PZR_P_HI_VOTE
    f_PZR_P_LO_Coinc = FB_VOTE_2OO4(f_A_PZR_P_LO_Trip, f_B_PZR_P_LO_Trip, f_C_PZR_P_LO_Trip, f_D_PZR_P_LO_Trip, f_A_PZR_P_LO_Byp, f_B_PZR_P_LO_Byp, f_C_PZR_P_LO_Byp, f_D_PZR_P_LO_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- PZR_P_LO_VOTE
    f_SG1_L_LO_Coinc = FB_VOTE_2OO4(f_A_SG1_L_LO_Trip, f_B_SG1_L_LO_Trip, f_C_SG1_L_LO_Trip, f_D_SG1_L_LO_Trip, f_A_SG1_L_LO_Byp, f_B_SG1_L_LO_Byp, f_C_SG1_L_LO_Byp, f_D_SG1_L_LO_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- SG1_L_LO_VOTE
    f_SG2_L_LO_Coinc = FB_VOTE_2OO4(f_A_SG2_L_LO_Trip, f_B_SG2_L_LO_Trip, f_C_SG2_L_LO_Trip, f_D_SG2_L_LO_Trip, f_A_SG2_L_LO_Byp, f_B_SG2_L_LO_Byp, f_C_SG2_L_LO_Byp, f_D_SG2_L_LO_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- SG2_L_LO_VOTE
    f_SG1_L_HI_Coinc = FB_VOTE_2OO4(f_A_SG1_L_HI_Trip, f_B_SG1_L_HI_Trip, f_C_SG1_L_HI_Trip, f_D_SG1_L_HI_Trip, f_A_SG1_L_HI_Byp, f_B_SG1_L_HI_Byp, f_C_SG1_L_HI_Byp, f_D_SG1_L_HI_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- SG1_L_HI_VOTE
    f_SG2_L_HI_Coinc = FB_VOTE_2OO4(f_A_SG2_L_HI_Trip, f_B_SG2_L_HI_Trip, f_C_SG2_L_HI_Trip, f_D_SG2_L_HI_Trip, f_A_SG2_L_HI_Byp, f_B_SG2_L_HI_Byp, f_C_SG2_L_HI_Byp, f_D_SG2_L_HI_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- SG2_L_HI_VOTE
    f_SG1_P_LO_Coinc = FB_VOTE_2OO4(f_A_SG1_P_LO_Trip, f_B_SG1_P_LO_Trip, f_C_SG1_P_LO_Trip, f_D_SG1_P_LO_Trip, f_A_SG1_P_LO_Byp, f_B_SG1_P_LO_Byp, f_C_SG1_P_LO_Byp, f_D_SG1_P_LO_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- SG1_P_LO_VOTE
    f_SG2_P_LO_Coinc = FB_VOTE_2OO4(f_A_SG2_P_LO_Trip, f_B_SG2_P_LO_Trip, f_C_SG2_P_LO_Trip, f_D_SG2_P_LO_Trip, f_A_SG2_P_LO_Byp, f_B_SG2_P_LO_Byp, f_C_SG2_P_LO_Byp, f_D_SG2_P_LO_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- SG2_P_LO_VOTE
    f_CTMT_P_HI_Coinc = FB_VOTE_2OO4(f_A_CTMT_P_HI_Trip, f_B_CTMT_P_HI_Trip, f_C_CTMT_P_HI_Trip, f_D_CTMT_P_HI_Trip, f_A_CTMT_P_HI_Byp, f_B_CTMT_P_HI_Byp, f_C_CTMT_P_HI_Byp, f_D_CTMT_P_HI_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- CTMT_P_HI_VOTE
    f_SG1_F_LO_Coinc = FB_VOTE_2OO4(f_A_SG1_F_LO_Trip, f_B_SG1_F_LO_Trip, f_C_SG1_F_LO_Trip, f_D_SG1_F_LO_Trip, f_A_SG1_F_LO_Byp, f_B_SG1_F_LO_Byp, f_C_SG1_F_LO_Byp, f_D_SG1_F_LO_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- SG1_F_LO_VOTE
    f_SG2_F_LO_Coinc = FB_VOTE_2OO4(f_A_SG2_F_LO_Trip, f_B_SG2_F_LO_Trip, f_C_SG2_F_LO_Trip, f_D_SG2_F_LO_Trip, f_A_SG2_F_LO_Byp, f_B_SG2_F_LO_Byp, f_C_SG2_F_LO_Byp, f_D_SG2_F_LO_Byp, f_A_Link_Error, f_B_Link_Error, f_C_Link_Error, f_D_Link_Error);  -- SG2_F_LO_VOTE
    f_RT_Init = FB_INITIATION((((((((((((((((not f_VOPT_Coinc) or (not f_LOGP_HI_Coinc)) or (not f_LPD_HI_Coinc)) or (not f_DNBR_LO_Coinc)) or (not f_PZR_P_HI_Coinc)) or (not f_PZR_P_LO_Coinc)) or (not f_SG1_L_LO_Coinc)) or (not f_SG2_L_LO_Coinc)) or (not f_SG1_L_HI_Coinc)) or (not f_SG2_L_HI_Coinc)) or (not f_SG1_P_LO_Coinc)) or (not f_SG2_P_LO_Coinc)) or (not f_CTMT_P_HI_Coinc)) or (not f_SG1_F_LO_Coinc)) or (not f_SG2_F_LO_Coinc)));  -- RT_INIT
  tel

end;
