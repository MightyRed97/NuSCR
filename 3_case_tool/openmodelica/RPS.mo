  package Blocks "The function blocks of the design, and expression blocks"
    block FB_RANGE_CHECK "Input validity check: VALID while the analog value lies inside [MIN, MAX]."
      parameter Real MIN "Lower limit of the valid range.";
      parameter Real MAX "Upper limit of the valid range.";
      RPS.Interfaces.RealInput X "Analog process value." annotation(Placement(transformation(extent={{-120,-10},{-100,10}}), iconTransformation(extent={{-120,-10},{-100,10}})));
      RPS.Interfaces.BooleanOutput VALID(start = false, fixed = true) "TRUE = valid. Value before the first scan: false." annotation(Placement(transformation(extent={{100,-10},{120,10}}), iconTransformation(extent={{100,-10},{120,10}})));
    equation
      when sample(0, RPS.Constants.T_scan) then
        VALID = ((X >= MIN) and (X <= MAX));
      end when;
      annotation(Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-30},{100,30}}), graphics={Rectangle(extent={{-100,30},{100,-30}}, lineColor={0,0,127}, fillColor={255,255,255}, fillPattern=FillPattern.Solid), Text(extent={{-160,64},{160,36}}, textString="%name", textColor={0,0,255}), Text(extent={{-96,28},{96,12}}, textString="FB_RANGE_CHECK", textColor={95,95,95}), Text(extent={{-96,8},{-2,-8}}, textString="X", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{2,8},{96,-8}}, textString="VALID", horizontalAlignment=TextAlignment.Right, textColor={0,0,0})}), Documentation(info="<html><p>Input validity check: VALID while the analog value lies inside [MIN, MAX].</p></html>"));
    end FB_RANGE_CHECK;

    block FB_PERMISSIVE_ABOVE "Operating-bypass permissive, rising: PERM while the input is valid and X >= LIM."
      parameter Real LIM "Permissive threshold.";
      RPS.Interfaces.BooleanInput VALID "Validity of X." annotation(Placement(transformation(extent={{-120,0},{-100,20}}), iconTransformation(extent={{-120,0},{-100,20}})));
      RPS.Interfaces.RealInput X "Analog value." annotation(Placement(transformation(extent={{-120,-20},{-100,0}}), iconTransformation(extent={{-120,-20},{-100,0}})));
      RPS.Interfaces.BooleanOutput PERM(start = false, fixed = true) "TRUE = bypass permitted. Value before the first scan: false." annotation(Placement(transformation(extent={{100,-10},{120,10}}), iconTransformation(extent={{100,-10},{120,10}})));
    equation
      when sample(0, RPS.Constants.T_scan) then
        PERM = (VALID and (X >= LIM));
      end when;
      annotation(Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-40},{100,40}}), graphics={Rectangle(extent={{-100,40},{100,-40}}, lineColor={0,0,127}, fillColor={255,255,255}, fillPattern=FillPattern.Solid), Text(extent={{-160,74},{160,46}}, textString="%name", textColor={0,0,255}), Text(extent={{-96,38},{96,22}}, textString="FB_PERMISSIVE_ABOVE", textColor={95,95,95}), Text(extent={{-96,18},{-2,2}}, textString="VALID", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-2},{-2,-18}}, textString="X", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{2,8},{96,-8}}, textString="PERM", horizontalAlignment=TextAlignment.Right, textColor={0,0,0})}), Documentation(info="<html><p>Operating-bypass permissive, rising: PERM while the input is valid and X &gt;= LIM.</p></html>"));
    end FB_PERMISSIVE_ABOVE;

    block FB_PERMISSIVE_BELOW "Operating-bypass permissive, falling: PERM while the input is valid and X < LIM."
