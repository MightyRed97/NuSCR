SSM::set RPS::BP/f_SG1_F 100.0
SSM::set RPS::BP/f_SG2_F 100.0
SSM::set RPS::BP/f_LPD_HI_Trip_In true
SSM::set RPS::BP/f_LPD_HI_Pretrip_In true
SSM::set RPS::BP/f_DNBR_LO_Trip_In true
SSM::set RPS::BP/f_DNBR_LO_Pretrip_In true
