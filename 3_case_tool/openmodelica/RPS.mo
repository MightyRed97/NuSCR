        discrete Integer f_LPD_HI_Trip_In_i(start = 0, fixed = true);
        discrete Integer f_LPD_HI_Pretrip_In_i(start = 0, fixed = true);
        discrete Integer f_DNBR_LO_Trip_In_i(start = 0, fixed = true);
        discrete Integer f_DNBR_LO_Pretrip_In_i(start = 0, fixed = true);
        discrete Integer f_CPC_Link_Error_i(start = 0, fixed = true);
        discrete Integer f_Module_Error_i(start = 0, fixed = true);
        discrete Integer f_Channel_Error_i(start = 0, fixed = true);
        discrete Integer f_LOGP_HI_OB_Ini_i(start = 0, fixed = true);
        discrete Integer f_LPD_HI_OB_Ini_i(start = 0, fixed = true);
        discrete Integer f_DNBR_LO_OB_Ini_i(start = 0, fixed = true);
        discrete Integer f_PZR_P_LO_OB_Ini_i(start = 0, fixed = true);
        discrete Integer f_SG1_P_LO_OB_Ini_i(start = 0, fixed = true);
        discrete Integer f_SG2_P_LO_OB_Ini_i(start = 0, fixed = true);
        discrete Integer f_SG1_F_LO_OB_Ini_i(start = 0, fixed = true);
        discrete Integer f_SG2_F_LO_OB_Ini_i(start = 0, fixed = true);
        discrete Integer f_PZR_P_LO_SP_Reset_i(start = 0, fixed = true);
        discrete Integer f_SG1_P_LO_SP_Reset_i(start = 0, fixed = true);
        discrete Integer f_SG2_P_LO_SP_Reset_i(start = 0, fixed = true);
        discrete Integer f_VOPT_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_LOGP_HI_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_LPD_HI_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_DNBR_LO_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_PZR_P_HI_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_PZR_P_LO_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_SG1_L_LO_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_SG2_L_LO_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_SG1_L_HI_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_SG2_L_HI_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_SG1_P_LO_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_SG2_P_LO_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_CTMT_P_HI_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_SG1_F_LO_Byp_Sw_i(start = 0, fixed = true);
        discrete Integer f_SG2_F_LO_Byp_Sw_i(start = 0, fixed = true);
      equation
        when sample(0, RPS.Constants.T_scan) then
          k = pre(k) + 1;
          f_NPWR_LIN_i = if pre(f_NPWR_LIN_i) < size(f_NPWR_LIN_at, 1) and f_NPWR_LIN_at[min(pre(f_NPWR_LIN_i) + 1, size(f_NPWR_LIN_at, 1))] <= k then pre(f_NPWR_LIN_i) + 1 else pre(f_NPWR_LIN_i);
          f_NPWR_LIN = f_NPWR_LIN_v[max(f_NPWR_LIN_i, 1)];
          f_NPWR_LOG_i = if pre(f_NPWR_LOG_i) < size(f_NPWR_LOG_at, 1) and f_NPWR_LOG_at[min(pre(f_NPWR_LOG_i) + 1, size(f_NPWR_LOG_at, 1))] <= k then pre(f_NPWR_LOG_i) + 1 else pre(f_NPWR_LOG_i);
          f_NPWR_LOG = f_NPWR_LOG_v[max(f_NPWR_LOG_i, 1)];
          f_PZR_P_i = if pre(f_PZR_P_i) < size(f_PZR_P_at, 1) and f_PZR_P_at[min(pre(f_PZR_P_i) + 1, size(f_PZR_P_at, 1))] <= k then pre(f_PZR_P_i) + 1 else pre(f_PZR_P_i);
          f_PZR_P = f_PZR_P_v[max(f_PZR_P_i, 1)];
          f_SG1_L_i = if pre(f_SG1_L_i) < size(f_SG1_L_at, 1) and f_SG1_L_at[min(pre(f_SG1_L_i) + 1, size(f_SG1_L_at, 1))] <= k then pre(f_SG1_L_i) + 1 else pre(f_SG1_L_i);
          f_SG1_L = f_SG1_L_v[max(f_SG1_L_i, 1)];
          f_SG2_L_i = if pre(f_SG2_L_i) < size(f_SG2_L_at, 1) and f_SG2_L_at[min(pre(f_SG2_L_i) + 1, size(f_SG2_L_at, 1))] <= k then pre(f_SG2_L_i) + 1 else pre(f_SG2_L_i);
          f_SG2_L = f_SG2_L_v[max(f_SG2_L_i, 1)];
          f_SG1_P_i = if pre(f_SG1_P_i) < size(f_SG1_P_at, 1) and f_SG1_P_at[min(pre(f_SG1_P_i) + 1, size(f_SG1_P_at, 1))] <= k then pre(f_SG1_P_i) + 1 else pre(f_SG1_P_i);
          f_SG1_P = f_SG1_P_v[max(f_SG1_P_i, 1)];
          f_SG2_P_i = if pre(f_SG2_P_i) < size(f_SG2_P_at, 1) and f_SG2_P_at[min(pre(f_SG2_P_i) + 1, size(f_SG2_P_at, 1))] <= k then pre(f_SG2_P_i) + 1 else pre(f_SG2_P_i);
          f_SG2_P = f_SG2_P_v[max(f_SG2_P_i, 1)];
          f_CTMT_P_i = if pre(f_CTMT_P_i) < size(f_CTMT_P_at, 1) and f_CTMT_P_at[min(pre(f_CTMT_P_i) + 1, size(f_CTMT_P_at, 1))] <= k then pre(f_CTMT_P_i) + 1 else pre(f_CTMT_P_i);
          f_CTMT_P = f_CTMT_P_v[max(f_CTMT_P_i, 1)];
          f_SG1_F_i = if pre(f_SG1_F_i) < size(f_SG1_F_at, 1) and f_SG1_F_at[min(pre(f_SG1_F_i) + 1, size(f_SG1_F_at, 1))] <= k then pre(f_SG1_F_i) + 1 else pre(f_SG1_F_i);
          f_SG1_F = f_SG1_F_v[max(f_SG1_F_i, 1)];
          f_SG2_F_i = if pre(f_SG2_F_i) < size(f_SG2_F_at, 1) and f_SG2_F_at[min(pre(f_SG2_F_i) + 1, size(f_SG2_F_at, 1))] <= k then pre(f_SG2_F_i) + 1 else pre(f_SG2_F_i);
          f_SG2_F = f_SG2_F_v[max(f_SG2_F_i, 1)];
