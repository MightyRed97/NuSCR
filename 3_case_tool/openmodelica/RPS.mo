      RPS.Interfaces.RealInput X "Analog value." annotation(Placement(transformation(extent={{-120,-20},{-100,0}}), iconTransformation(extent={{-120,-20},{-100,0}})));
      RPS.Interfaces.BooleanOutput PERM(start = false, fixed = true) "TRUE = bypass permitted. Value before the first scan: false." annotation(Placement(transformation(extent={{100,-10},{120,10}}), iconTransformation(extent={{100,-10},{120,10}})));
    equation
      when sample(0, RPS.Constants.T_scan) then
        PERM = (VALID and (X < LIM));
      end when;
      annotation(Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-40},{100,40}}), graphics={Rectangle(extent={{-100,40},{100,-40}}, lineColor={0,0,127}, fillColor={255,255,255}, fillPattern=FillPattern.Solid), Text(extent={{-160,74},{160,46}}, textString="%name", textColor={0,0,255}), Text(extent={{-96,38},{96,22}}, textString="FB_PERMISSIVE_BELOW", textColor={95,95,95}), Text(extent={{-96,18},{-2,2}}, textString="VALID", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-2},{-2,-18}}, textString="X", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{2,8},{96,-8}}, textString="PERM", horizontalAlignment=TextAlignment.Right, textColor={0,0,0})}), Documentation(info="<html><p>Operating-bypass permissive, falling: PERM while the input is valid and X &lt; LIM.</p></html>"));
    end FB_PERMISSIVE_BELOW;

    block FB_EDGE "Rising-edge detector: one-scan pulse per press. PREV starts TRUE, so a pushbutton that is held or stuck at power-up is ignored until it has been seen released (an IEC 61131-3 R_TRIG whose memory starts TRUE instead of the standard FALSE)."
      RPS.Interfaces.BooleanInput PB "Pushbutton." annotation(Placement(transformation(extent={{-120,-10},{-100,10}}), iconTransformation(extent={{-120,-10},{-100,10}})));
      RPS.Interfaces.BooleanOutput Q(start = false, fixed = true) "TRUE for exactly one scan per press. Value before the first scan: false." annotation(Placement(transformation(extent={{100,-10},{120,10}}), iconTransformation(extent={{100,-10},{120,10}})));
      Boolean PREV(start = true, fixed = true) "State: Pushbutton value in the previous scan.";
    equation
      when sample(0, RPS.Constants.T_scan) then
        Q = (PB and (not pre(PREV)));
        PREV = PB;
      end when;
      annotation(Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-30},{100,30}}), graphics={Rectangle(extent={{-100,30},{100,-30}}, lineColor={0,0,127}, fillColor={255,255,255}, fillPattern=FillPattern.Solid), Text(extent={{-160,64},{160,36}}, textString="%name", textColor={0,0,255}), Text(extent={{-96,28},{96,12}}, textString="FB_EDGE", textColor={95,95,95}), Text(extent={{-96,8},{-2,-8}}, textString="PB", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{2,8},{96,-8}}, textString="Q", horizontalAlignment=TextAlignment.Right, textColor={0,0,0})}), Documentation(info="<html><p>Rising-edge detector: one-scan pulse per press. PREV starts TRUE, so a pushbutton that is held or stuck at power-up is ignored until it has been seen released (an IEC 61131-3 R_TRIG whose memory starts TRUE instead of the standard FALSE).</p></html>"));
    end FB_EDGE;

    block FB_OPERATING_BYPASS "Operating bypass: reset-dominant latch, set by an initiation pulse while the permissive holds and reset in the first scan without permissive. Starts removed."
      RPS.Interfaces.BooleanInput PERM "Bypass permissive." annotation(Placement(transformation(extent={{-120,0},{-100,20}}), iconTransformation(extent={{-120,0},{-100,20}})));
      RPS.Interfaces.BooleanInput PULSE "Initiation pulse from FB_EDGE." annotation(Placement(transformation(extent={{-120,-20},{-100,0}}), iconTransformation(extent={{-120,-20},{-100,0}})));
      RPS.Interfaces.BooleanOutput Q(start = false, fixed = true) "TRUE = bypassed. Value before the first scan: false." annotation(Placement(transformation(extent={{100,-10},{120,10}}), iconTransformation(extent={{100,-10},{120,10}})));
      Boolean MEM(start = false, fixed = true) "State: Bypass memory.";
    equation
      when sample(0, RPS.Constants.T_scan) then
        MEM = (PERM and (pre(MEM) or PULSE));
        Q = MEM;
      end when;
      annotation(Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-40},{100,40}}), graphics={Rectangle(extent={{-100,40},{100,-40}}, lineColor={0,0,127}, fillColor={255,255,255}, fillPattern=FillPattern.Solid), Text(extent={{-160,74},{160,46}}, textString="%name", textColor={0,0,255}), Text(extent={{-96,38},{96,22}}, textString="FB_OPERATING_BYPASS", textColor={95,95,95}), Text(extent={{-96,18},{-2,2}}, textString="PERM", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-2},{-2,-18}}, textString="PULSE", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{2,8},{96,-8}}, textString="Q", horizontalAlignment=TextAlignment.Right, textColor={0,0,0})}), Documentation(info="<html><p>Operating bypass: reset-dominant latch, set by an initiation pulse while the permissive holds and reset in the first scan without permissive. Starts removed.</p></html>"));
    end FB_OPERATING_BYPASS;

    block FB_LIMIT "Clamp: Q = MN if IN <= MN, MX if IN >= MX, otherwise IN."
      parameter Real MN "Lower limit.";
      parameter Real MX "Upper limit.";
      RPS.Interfaces.RealInput IN "Unconstrained value." annotation(Placement(transformation(extent={{-120,-10},{-100,10}}), iconTransformation(extent={{-120,-10},{-100,10}})));
      RPS.Interfaces.RealOutput Q(start = 0.0, fixed = true) "Clamped value. Value before the first scan: 0.0." annotation(Placement(transformation(extent={{100,-10},{120,10}}), iconTransformation(extent={{100,-10},{120,10}})));
    equation
      when sample(0, RPS.Constants.T_scan) then
        Q = if (IN <= MN) then MN
          elseif (IN >= MX) then MX
          else IN;
      end when;
      annotation(Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-30},{100,30}}), graphics={Rectangle(extent={{-100,30},{100,-30}}, lineColor={0,0,127}, fillColor={255,255,255}, fillPattern=FillPattern.Solid), Text(extent={{-160,64},{160,36}}, textString="%name", textColor={0,0,255}), Text(extent={{-96,28},{96,12}}, textString="FB_LIMIT", textColor={95,95,95}), Text(extent={{-96,8},{-2,-8}}, textString="IN", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{2,8},{96,-8}}, textString="Q", horizontalAlignment=TextAlignment.Right, textColor={0,0,0})}), Documentation(info="<html><p>Clamp: Q = MN if IN &lt;= MN, MX if IN &gt;= MX, otherwise IN.</p></html>"));
    end FB_LIMIT;

    block FB_SP_RATE_UP "Variable setpoint that follows a decreasing target at once and rises by at most STEP per scan. It starts at INIT, is set to the target on the first scan with a valid input, and holds while the input is invalid. The start value is applied on the first scan (STARTED) so that every state variable has a constant initial value."
      parameter Real STEP "Maximum rise per scan.";
      parameter Real INIT "Setpoint value until the first valid scan.";
      RPS.Interfaces.BooleanInput VALID "Validity of the process input." annotation(Placement(transformation(extent={{-120,0},{-100,20}}), iconTransformation(extent={{-120,0},{-100,20}})));
      RPS.Interfaces.RealInput TGT "Setpoint target from FB_LIMIT." annotation(Placement(transformation(extent={{-120,-20},{-100,0}}), iconTransformation(extent={{-120,-20},{-100,0}})));
      RPS.Interfaces.RealOutput Q(start = 0.0, fixed = true) "Setpoint. Value before the first scan: 0.0." annotation(Placement(transformation(extent={{100,-10},{120,10}}), iconTransformation(extent={{100,-10},{120,10}})));
      Real SP(start = 0.0, fixed = true) "State: Setpoint.";
      Boolean READY(start = false, fixed = true) "State: TRUE once set from a valid input.";
      Boolean STARTED(start = false, fixed = true) "State: TRUE after the first scan.";
      Real SP0(start = 0.0, fixed = true) "Local: Setpoint at the start of this scan.";
    equation
      when sample(0, RPS.Constants.T_scan) then
        SP0 = if (not pre(STARTED)) then INIT
          else pre(SP);
        SP = if (not VALID) then SP0
          elseif (not pre(READY)) then TGT
          elseif (TGT <= SP0) then TGT
          elseif ((TGT - SP0) <= STEP) then TGT
          else (SP0 + STEP);
        READY = if VALID then true
          else pre(READY);
        STARTED = true;
        Q = SP;
      end when;
      annotation(Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-40},{100,40}}), graphics={Rectangle(extent={{-100,40},{100,-40}}, lineColor={0,0,127}, fillColor={255,255,255}, fillPattern=FillPattern.Solid), Text(extent={{-160,74},{160,46}}, textString="%name", textColor={0,0,255}), Text(extent={{-96,38},{96,22}}, textString="FB_SP_RATE_UP", textColor={95,95,95}), Text(extent={{-96,18},{-2,2}}, textString="VALID", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-2},{-2,-18}}, textString="TGT", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{2,8},{96,-8}}, textString="Q", horizontalAlignment=TextAlignment.Right, textColor={0,0,0})}), Documentation(info="<html><p>Variable setpoint that follows a decreasing target at once and rises by at most STEP per scan. It starts at INIT, is set to the target on the first scan with a valid input, and holds while the input is invalid. The start value is applied on the first scan (STARTED) so that every state variable has a constant initial value.</p></html>"));
    end FB_SP_RATE_UP;

    block FB_SP_RATE_DOWN "Variable setpoint that follows an increasing target at once and falls by at most STEP per scan. It starts at INIT, is set to the target on the first scan with a valid input, and holds while the input is invalid."
      parameter Real STEP "Maximum fall per scan.";
      parameter Real INIT "Setpoint value until the first valid scan.";
      RPS.Interfaces.BooleanInput VALID "Validity of the process input." annotation(Placement(transformation(extent={{-120,0},{-100,20}}), iconTransformation(extent={{-120,0},{-100,20}})));
      RPS.Interfaces.RealInput TGT "Setpoint target from FB_LIMIT." annotation(Placement(transformation(extent={{-120,-20},{-100,0}}), iconTransformation(extent={{-120,-20},{-100,0}})));
      RPS.Interfaces.RealOutput Q(start = 0.0, fixed = true) "Setpoint. Value before the first scan: 0.0." annotation(Placement(transformation(extent={{100,-10},{120,10}}), iconTransformation(extent={{100,-10},{120,10}})));
      Real SP(start = 0.0, fixed = true) "State: Setpoint.";
      Boolean READY(start = false, fixed = true) "State: TRUE once set from a valid input.";
      Boolean STARTED(start = false, fixed = true) "State: TRUE after the first scan.";
      Real SP0(start = 0.0, fixed = true) "Local: Setpoint at the start of this scan.";
    equation
      when sample(0, RPS.Constants.T_scan) then
        SP0 = if (not pre(STARTED)) then INIT
          else pre(SP);
        SP = if (not VALID) then SP0
          elseif (not pre(READY)) then TGT
          elseif (TGT >= SP0) then TGT
          elseif ((SP0 - TGT) <= STEP) then TGT
          else (SP0 - STEP);
        READY = if VALID then true
          else pre(READY);
        STARTED = true;
        Q = SP;
      end when;
      annotation(Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-40},{100,40}}), graphics={Rectangle(extent={{-100,40},{100,-40}}, lineColor={0,0,127}, fillColor={255,255,255}, fillPattern=FillPattern.Solid), Text(extent={{-160,74},{160,46}}, textString="%name", textColor={0,0,255}), Text(extent={{-96,38},{96,22}}, textString="FB_SP_RATE_DOWN", textColor={95,95,95}), Text(extent={{-96,18},{-2,2}}, textString="VALID", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-2},{-2,-18}}, textString="TGT", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{2,8},{96,-8}}, textString="Q", horizontalAlignment=TextAlignment.Right, textColor={0,0,0})}), Documentation(info="<html><p>Variable setpoint that follows an increasing target at once and falls by at most STEP per scan. It starts at INIT, is set to the target on the first scan with a valid input, and holds while the input is invalid.</p></html>"));
    end FB_SP_RATE_DOWN;

    block FB_SP_MANUAL_RESET "Manually reset falling setpoint: starts at MAX, rises automatically to stay no more than BAND below X (up to MAX); each reset pulse lowers it to X - BAND (not below MIN). Holds while the input is invalid."
      parameter Real BAND "Band below the process value.";
      parameter Real MIN "Setpoint floor.";
      parameter Real MAX "Setpoint ceiling.";
      RPS.Interfaces.BooleanInput VALID "Validity of X." annotation(Placement(transformation(extent={{-120,10},{-100,30}}), iconTransformation(extent={{-120,10},{-100,30}})));
      RPS.Interfaces.RealInput X "Process value." annotation(Placement(transformation(extent={{-120,-10},{-100,10}}), iconTransformation(extent={{-120,-10},{-100,10}})));
      RPS.Interfaces.BooleanInput PULSE "Reset pulse from FB_EDGE." annotation(Placement(transformation(extent={{-120,-30},{-100,-10}}), iconTransformation(extent={{-120,-30},{-100,-10}})));
      RPS.Interfaces.RealOutput Q(start = 0.0, fixed = true) "Setpoint. Value before the first scan: 0.0." annotation(Placement(transformation(extent={{100,-10},{120,10}}), iconTransformation(extent={{100,-10},{120,10}})));
      Real SP(start = 0.0, fixed = true) "State: Setpoint.";
      Boolean STARTED(start = false, fixed = true) "State: TRUE after the first scan.";
      Real SP0(start = 0.0, fixed = true) "Local: Setpoint at the start of this scan.";
      Real D(start = 0.0, fixed = true) "Local: Process value minus band.";
    equation
      when sample(0, RPS.Constants.T_scan) then
        SP0 = if (not pre(STARTED)) then MAX
          else pre(SP);
        D = (X - BAND);
        SP = if (not VALID) then SP0
          elseif ((D > SP0) and (D <= MAX)) then D
          elseif ((D > MAX) and (SP0 < MAX)) then MAX
          elseif ((PULSE and (D < SP0)) and (D >= MIN)) then D
          elseif ((PULSE and (D < MIN)) and (SP0 > MIN)) then MIN
          else SP0;
        STARTED = true;
        Q = SP;
      end when;
      annotation(Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-50},{100,50}}), graphics={Rectangle(extent={{-100,50},{100,-50}}, lineColor={0,0,127}, fillColor={255,255,255}, fillPattern=FillPattern.Solid), Text(extent={{-160,84},{160,56}}, textString="%name", textColor={0,0,255}), Text(extent={{-96,48},{96,32}}, textString="FB_SP_MANUAL_RESET", textColor={95,95,95}), Text(extent={{-96,28},{-2,12}}, textString="VALID", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,8},{-2,-8}}, textString="X", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-12},{-2,-28}}, textString="PULSE", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{2,8},{96,-8}}, textString="Q", horizontalAlignment=TextAlignment.Right, textColor={0,0,0})}), Documentation(info="<html><p>Manually reset falling setpoint: starts at MAX, rises automatically to stay no more than BAND below X (up to MAX); each reset pulse lowers it to X - BAND (not below MIN). Holds while the input is invalid.</p></html>"));
    end FB_SP_MANUAL_RESET;

    block FB_TRIP_BISTABLE "Trip (or pre-trip) bistable with persistence counter, hysteresis latch and fail-safe error handling. LATCH holds a process trip: it is kept through errors and released only by RESET or BYP in an error-free scan. HOLD keeps the output tripped after an error or at start-up until the condition clears or has persisted for DELAY scans. TIMING and CNT count the persistence of the arming condition in scans (CNT stays in [0, DELAY - 1])."
      parameter Integer DELAY(min = 1) "Persistence delay in scans (delay constant / scan period).";
      RPS.Interfaces.BooleanInput OK "TRUE = no error of the function." annotation(Placement(transformation(extent={{-120,20},{-100,40}}), iconTransformation(extent={{-120,20},{-100,40}})));
      RPS.Interfaces.BooleanInput BYP "Operating bypass active (FALSE for functions without bypass)." annotation(Placement(transformation(extent={{-120,0},{-100,20}}), iconTransformation(extent={{-120,0},{-100,20}})));
      RPS.Interfaces.BooleanInput COND "Trip (pre-trip) condition." annotation(Placement(transformation(extent={{-120,-20},{-100,0}}), iconTransformation(extent={{-120,-20},{-100,0}})));
      RPS.Interfaces.BooleanInput RESET "Recovered past the setpoint by more than the hysteresis." annotation(Placement(transformation(extent={{-120,-40},{-100,-20}}), iconTransformation(extent={{-120,-40},{-100,-20}})));
      RPS.Interfaces.BooleanOutput Q(start = false, fixed = true) "TRUE = NORMAL, FALSE = TRIP. Value before the first scan: false." annotation(Placement(transformation(extent={{100,-10},{120,10}}), iconTransformation(extent={{100,-10},{120,10}})));
      Boolean LATCH(start = false, fixed = true) "State: Process trip latched.";
      Boolean HOLD(start = true, fixed = true) "State: Output held tripped after an error or at start-up.";
      Boolean TIMING(start = false, fixed = true) "State: Persistence being timed.";
      Integer CNT(start = 0, fixed = true) "State: Scans the arming condition has persisted since timing started.";
      Boolean ARM(start = false, fixed = true) "Local: Arming condition: no error, no bypass, condition present.";
      Boolean REL(start = false, fixed = true) "Local: Release condition of a latched process trip.";
      Boolean FIRE(start = false, fixed = true) "Local: Persistence delay completed in this scan.";
    equation
      when sample(0, RPS.Constants.T_scan) then
        ARM = ((OK and (not BYP)) and COND);
        REL = (OK and (BYP or RESET));
        FIRE = ((((OK and (not pre(LATCH))) and ARM) and pre(TIMING)) and ((pre(CNT) + 1) >= DELAY));
        LATCH = if (not OK) then pre(LATCH)
          elseif (pre(LATCH) and REL) then false
          elseif pre(LATCH) then true
          elseif FIRE then true
          else false;
        HOLD = if ((not OK) and (not pre(LATCH))) then true
          elseif (not OK) then pre(HOLD)
          elseif (pre(LATCH) and REL) then false
          elseif pre(LATCH) then pre(HOLD)
          elseif (not ARM) then false
          elseif FIRE then false
          else pre(HOLD);
        TIMING = if (not OK) then false
          elseif pre(LATCH) then pre(TIMING)
          elseif (not ARM) then false
          elseif FIRE then false
          else true;
        CNT = if (not OK) then 0
          elseif pre(LATCH) then pre(CNT)
          elseif (not ARM) then 0
          elseif FIRE then 0
          elseif pre(TIMING) then (pre(CNT) + 1)
          else 0;
        Q = ((not LATCH) and (not HOLD));
      end when;
      annotation(Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-60},{100,60}}), graphics={Rectangle(extent={{-100,60},{100,-60}}, lineColor={0,0,127}, fillColor={255,255,255}, fillPattern=FillPattern.Solid), Text(extent={{-160,94},{160,66}}, textString="%name", textColor={0,0,255}), Text(extent={{-96,58},{96,42}}, textString="FB_TRIP_BISTABLE", textColor={95,95,95}), Text(extent={{-96,38},{-2,22}}, textString="OK", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,18},{-2,2}}, textString="BYP", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-2},{-2,-18}}, textString="COND", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-22},{-2,-38}}, textString="RESET", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{2,8},{96,-8}}, textString="Q", horizontalAlignment=TextAlignment.Right, textColor={0,0,0})}), Documentation(info="<html><p>Trip (or pre-trip) bistable with persistence counter, hysteresis latch and fail-safe error handling. LATCH holds a process trip: it is kept through errors and released only by RESET or BYP in an error-free scan. HOLD keeps the output tripped after an error or at start-up until the condition clears or has persisted for DELAY scans. TIMING and CNT count the persistence of the arming condition in scans (CNT stays in [0, DELAY - 1]).</p></html>"));
    end FB_TRIP_BISTABLE;

    block FB_VOTE_2OO4 "2-out-of-4 coincidence with trip channel bypass (2-out-of-3 when exactly one channel requests bypass; all requests ignored when two or more do) and failed links counted as trip votes. Pure boolean logic, no arithmetic."
      RPS.Interfaces.BooleanInput TRIP_A "Trip of channel A (FALSE = TRIP)." annotation(Placement(transformation(extent={{-120,100},{-100,120}}), iconTransformation(extent={{-120,100},{-100,120}})));
      RPS.Interfaces.BooleanInput TRIP_B "Trip of channel B (FALSE = TRIP)." annotation(Placement(transformation(extent={{-120,80},{-100,100}}), iconTransformation(extent={{-120,80},{-100,100}})));
      RPS.Interfaces.BooleanInput TRIP_C "Trip of channel C (FALSE = TRIP)." annotation(Placement(transformation(extent={{-120,60},{-100,80}}), iconTransformation(extent={{-120,60},{-100,80}})));
      RPS.Interfaces.BooleanInput TRIP_D "Trip of channel D (FALSE = TRIP)." annotation(Placement(transformation(extent={{-120,40},{-100,60}}), iconTransformation(extent={{-120,40},{-100,60}})));
      RPS.Interfaces.BooleanInput BYP_A "Trip channel bypass request of channel A." annotation(Placement(transformation(extent={{-120,20},{-100,40}}), iconTransformation(extent={{-120,20},{-100,40}})));
      RPS.Interfaces.BooleanInput BYP_B "Trip channel bypass request of channel B." annotation(Placement(transformation(extent={{-120,0},{-100,20}}), iconTransformation(extent={{-120,0},{-100,20}})));
      RPS.Interfaces.BooleanInput BYP_C "Trip channel bypass request of channel C." annotation(Placement(transformation(extent={{-120,-20},{-100,0}}), iconTransformation(extent={{-120,-20},{-100,0}})));
      RPS.Interfaces.BooleanInput BYP_D "Trip channel bypass request of channel D." annotation(Placement(transformation(extent={{-120,-40},{-100,-20}}), iconTransformation(extent={{-120,-40},{-100,-20}})));
      RPS.Interfaces.BooleanInput LINK_A "Data-link failure of channel A." annotation(Placement(transformation(extent={{-120,-60},{-100,-40}}), iconTransformation(extent={{-120,-60},{-100,-40}})));
      RPS.Interfaces.BooleanInput LINK_B "Data-link failure of channel B." annotation(Placement(transformation(extent={{-120,-80},{-100,-60}}), iconTransformation(extent={{-120,-80},{-100,-60}})));
      RPS.Interfaces.BooleanInput LINK_C "Data-link failure of channel C." annotation(Placement(transformation(extent={{-120,-100},{-100,-80}}), iconTransformation(extent={{-120,-100},{-100,-80}})));
      RPS.Interfaces.BooleanInput LINK_D "Data-link failure of channel D." annotation(Placement(transformation(extent={{-120,-120},{-100,-100}}), iconTransformation(extent={{-120,-120},{-100,-100}})));
      RPS.Interfaces.BooleanOutput COINC(start = false, fixed = true) "TRUE = NORMAL, FALSE = coincidence trip. Value before the first scan: false." annotation(Placement(transformation(extent={{100,-10},{120,10}}), iconTransformation(extent={{100,-10},{120,10}})));
      Boolean ONE_BYP(start = false, fixed = true) "Local: Exactly one channel requests bypass.";
      Boolean V_A(start = false, fixed = true) "Local: Channel A votes to trip (positive logic).";
      Boolean V_B(start = false, fixed = true) "Local: Channel B votes to trip (positive logic).";
      Boolean V_C(start = false, fixed = true) "Local: Channel C votes to trip (positive logic).";
      Boolean V_D(start = false, fixed = true) "Local: Channel D votes to trip (positive logic).";
    equation
      when sample(0, RPS.Constants.T_scan) then
        ONE_BYP = ((((((BYP_A and (not BYP_B)) and (not BYP_C)) and (not BYP_D)) or ((((not BYP_A) and BYP_B) and (not BYP_C)) and (not BYP_D))) or ((((not BYP_A) and (not BYP_B)) and BYP_C) and (not BYP_D))) or ((((not BYP_A) and (not BYP_B)) and (not BYP_C)) and BYP_D));
        V_A = ((not (BYP_A and ONE_BYP)) and ((not TRIP_A) or LINK_A));
        V_B = ((not (BYP_B and ONE_BYP)) and ((not TRIP_B) or LINK_B));
        V_C = ((not (BYP_C and ONE_BYP)) and ((not TRIP_C) or LINK_C));
        V_D = ((not (BYP_D and ONE_BYP)) and ((not TRIP_D) or LINK_D));
        COINC = (not ((((((V_A and V_B) or (V_A and V_C)) or (V_A and V_D)) or (V_B and V_C)) or (V_B and V_D)) or (V_C and V_D)));
      end when;
      annotation(Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-140},{100,140}}), graphics={Rectangle(extent={{-100,140},{100,-140}}, lineColor={0,0,127}, fillColor={255,255,255}, fillPattern=FillPattern.Solid), Text(extent={{-160,174},{160,146}}, textString="%name", textColor={0,0,255}), Text(extent={{-96,138},{96,122}}, textString="FB_VOTE_2OO4", textColor={95,95,95}), Text(extent={{-96,118},{-2,102}}, textString="TRIP_A", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,98},{-2,82}}, textString="TRIP_B", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,78},{-2,62}}, textString="TRIP_C", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,58},{-2,42}}, textString="TRIP_D", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,38},{-2,22}}, textString="BYP_A", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,18},{-2,2}}, textString="BYP_B", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-2},{-2,-18}}, textString="BYP_C", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-22},{-2,-38}}, textString="BYP_D", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-42},{-2,-58}}, textString="LINK_A", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-62},{-2,-78}}, textString="LINK_B", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-82},{-2,-98}}, textString="LINK_C", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{-96,-102},{-2,-118}}, textString="LINK_D", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{2,8},{96,-8}}, textString="COINC", horizontalAlignment=TextAlignment.Right, textColor={0,0,0})}), Documentation(info="<html><p>2-out-of-4 coincidence with trip channel bypass (2-out-of-3 when exactly one channel requests bypass; all requests ignored when two or more do) and failed links counted as trip votes. Pure boolean logic, no arithmetic.</p></html>"));
    end FB_VOTE_2OO4;

    block FB_INITIATION "Reactor trip initiation: Q is FALSE (initiate) when any coincidence trip is present."
      RPS.Interfaces.BooleanInput TRIPPED "At least one coincidence trip (positive logic)." annotation(Placement(transformation(extent={{-120,-10},{-100,10}}), iconTransformation(extent={{-120,-10},{-100,10}})));
      RPS.Interfaces.BooleanOutput Q(start = false, fixed = true) "TRUE = NORMAL, FALSE = initiate reactor trip. Value before the first scan: false." annotation(Placement(transformation(extent={{100,-10},{120,10}}), iconTransformation(extent={{100,-10},{120,10}})));
    equation
      when sample(0, RPS.Constants.T_scan) then
        Q = (not TRIPPED);
      end when;
      annotation(Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-30},{100,30}}), graphics={Rectangle(extent={{-100,30},{100,-30}}, lineColor={0,0,127}, fillColor={255,255,255}, fillPattern=FillPattern.Solid), Text(extent={{-160,64},{160,36}}, textString="%name", textColor={0,0,255}), Text(extent={{-96,28},{96,12}}, textString="FB_INITIATION", textColor={95,95,95}), Text(extent={{-96,8},{-2,-8}}, textString="TRIPPED", horizontalAlignment=TextAlignment.Left, textColor={0,0,0}), Text(extent={{2,8},{96,-8}}, textString="Q", horizontalAlignment=TextAlignment.Right, textColor={0,0,0})}), Documentation(info="<html><p>Reactor trip initiation: Q is FALSE (initiate) when any coincidence trip is present.</p></html>"));
    end FB_INITIATION;

