      block LossOfFlow4ch_Stimulus_CP_A "Inputs of CP_A in Four-channel scenario loss_of_flow_4ch (5_simulation/scenarios/loss_of_flow_4ch.csv)"
        parameter Integer f_A_Link_Error_at[:] = {0} "Increasing scans at which f_A_Link_Error takes a new value; the first is 0";
        parameter Boolean f_A_Link_Error_v[size(f_A_Link_Error_at, 1)] = {false} "Value of f_A_Link_Error from each of those scans on";
        parameter Integer f_B_Link_Error_at[:] = {0} "Increasing scans at which f_B_Link_Error takes a new value; the first is 0";
        parameter Boolean f_B_Link_Error_v[size(f_B_Link_Error_at, 1)] = {false} "Value of f_B_Link_Error from each of those scans on";
        parameter Integer f_C_Link_Error_at[:] = {0} "Increasing scans at which f_C_Link_Error takes a new value; the first is 0";
        parameter Boolean f_C_Link_Error_v[size(f_C_Link_Error_at, 1)] = {false} "Value of f_C_Link_Error from each of those scans on";
        parameter Integer f_D_Link_Error_at[:] = {0} "Increasing scans at which f_D_Link_Error takes a new value; the first is 0";
        parameter Boolean f_D_Link_Error_v[size(f_D_Link_Error_at, 1)] = {false} "Value of f_D_Link_Error from each of those scans on";
        discrete Integer k(start = -1, fixed = true) "The scan being computed (0 = first scan)";
        RPS.Interfaces.BooleanOutput f_A_Link_Error(start = false, fixed = true) annotation(Placement(transformation(extent={{100,20},{120,40}}), iconTransformation(extent={{100,20},{120,40}})));
        RPS.Interfaces.BooleanOutput f_B_Link_Error(start = false, fixed = true) annotation(Placement(transformation(extent={{100,0},{120,20}}), iconTransformation(extent={{100,0},{120,20}})));
        RPS.Interfaces.BooleanOutput f_C_Link_Error(start = false, fixed = true) annotation(Placement(transformation(extent={{100,-20},{120,0}}), iconTransformation(extent={{100,-20},{120,0}})));
        RPS.Interfaces.BooleanOutput f_D_Link_Error(start = false, fixed = true) annotation(Placement(transformation(extent={{100,-40},{120,-20}}), iconTransformation(extent={{100,-40},{120,-20}})));
        discrete Integer f_A_Link_Error_i(start = 0, fixed = true);
        discrete Integer f_B_Link_Error_i(start = 0, fixed = true);
        discrete Integer f_C_Link_Error_i(start = 0, fixed = true);
        discrete Integer f_D_Link_Error_i(start = 0, fixed = true);
      equation
        when sample(0, RPS.Constants.T_scan) then
          k = pre(k) + 1;
          f_A_Link_Error_i = if pre(f_A_Link_Error_i) < size(f_A_Link_Error_at, 1) and f_A_Link_Error_at[min(pre(f_A_Link_Error_i) + 1, size(f_A_Link_Error_at, 1))] <= k then pre(f_A_Link_Error_i) + 1 else pre(f_A_Link_Error_i);
          f_A_Link_Error = f_A_Link_Error_v[max(f_A_Link_Error_i, 1)];
          f_B_Link_Error_i = if pre(f_B_Link_Error_i) < size(f_B_Link_Error_at, 1) and f_B_Link_Error_at[min(pre(f_B_Link_Error_i) + 1, size(f_B_Link_Error_at, 1))] <= k then pre(f_B_Link_Error_i) + 1 else pre(f_B_Link_Error_i);
          f_B_Link_Error = f_B_Link_Error_v[max(f_B_Link_Error_i, 1)];
          f_C_Link_Error_i = if pre(f_C_Link_Error_i) < size(f_C_Link_Error_at, 1) and f_C_Link_Error_at[min(pre(f_C_Link_Error_i) + 1, size(f_C_Link_Error_at, 1))] <= k then pre(f_C_Link_Error_i) + 1 else pre(f_C_Link_Error_i);
          f_C_Link_Error = f_C_Link_Error_v[max(f_C_Link_Error_i, 1)];
          f_D_Link_Error_i = if pre(f_D_Link_Error_i) < size(f_D_Link_Error_at, 1) and f_D_Link_Error_at[min(pre(f_D_Link_Error_i) + 1, size(f_D_Link_Error_at, 1))] <= k then pre(f_D_Link_Error_i) + 1 else pre(f_D_Link_Error_i);
          f_D_Link_Error = f_D_Link_Error_v[max(f_D_Link_Error_i, 1)];
        end when;
        annotation(Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,-60},{100,60}}), graphics={Rectangle(extent={{-100,60},{100,-60}}, lineColor={0,127,0}, fillColor={240,250,240}, fillPattern=FillPattern.Solid), Text(extent={{-160,94},{160,66}}, textString="%name", textColor={0,0,255}), Text(extent={{-96,58},{96,42}}, textString="stimulus", textColor={95,95,95}), Text(extent={{2,38},{96,22}}, textString="f_A_Link_Error", horizontalAlignment=TextAlignment.Right, textColor={0,0,0}), Text(extent={{2,18},{96,2}}, textString="f_B_Link_Error", horizontalAlignment=TextAlignment.Right, textColor={0,0,0}), Text(extent={{2,-2},{96,-18}}, textString="f_C_Link_Error", horizontalAlignment=TextAlignment.Right, textColor={0,0,0}), Text(extent={{2,-22},{96,-38}}, textString="f_D_Link_Error", horizontalAlignment=TextAlignment.Right, textColor={0,0,0})}));
      end LossOfFlow4ch_Stimulus_CP_A;

