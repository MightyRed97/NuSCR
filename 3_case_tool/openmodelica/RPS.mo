  end CP;

  partial model System "Four redundant channels A-D, each with a bistable processor; every coincidence processor receives the bistable outputs of all four channels. Links are modelled as ideal (same-scan) transfers; link failure is modelled by the CP inputs `f_<ch>_Link_Error`."
    RPS.BP BP_A "BP of channel A" annotation(Placement(transformation(extent={{0,-238.5},{50,-8.5}})));
    RPS.BP BP_B "BP of channel B" annotation(Placement(transformation(extent={{0,-537},{50,-307}})));
    RPS.BP BP_C "BP of channel C" annotation(Placement(transformation(extent={{0,-835.5},{50,-605.5}})));
    RPS.BP BP_D "BP of channel D" annotation(Placement(transformation(extent={{0,-1134},{50,-904}})));
    RPS.CP CP_A "Representative coincidence processor; those of channels B-D are identical." annotation(Placement(transformation(extent={{520,-638.5},{570,-8.5}})));
